import java.time.LocalDate;
import java.util.UUID;

public class TransactionFactory {
    public static Transaction createTransaction(String transactionId, Buyer buyerId, Seller sellerId, Listing listing, int quantity,double price,double total, LocalDate pdate) {
        if(Helper.isNullOrEmpty(transactionId)){
            throw new IllegalArgumentException("Id cannot be null");
        }
        if(buyerId == null){
            throw new IllegalArgumentException("Id cannot be null");
        }
        if(sellerId == null){
            throw new IllegalArgumentException("Id cannot be null");
        }
        if(listing == null){
            throw new IllegalArgumentException("Id cannot be null");
        }
        if(quantity<0){
            throw new IllegalArgumentException("quantity cannot zero");
        }
        if(price<0){
            throw new IllegalArgumentException("price cannot be less than zero");
        }
        if(total<0){
            throw new IllegalArgumentException("total cannot be less than zero");
        }
        if(pdate==null){
            throw new IllegalArgumentException("date cannot be null");
        }
        return new Transaction.Builder()
                .setTransactionId(generatedId(transactionId))
                .setBuyerId(buyerId)
                .setSellerId(sellerId)
                .setListing(listing)
                .setQuantity(quantity)
                .setPrice(price)
                .setTotal(total)
                .setPdate(pdate)
                .build();
    }
private static String generatedId(String id){
   return "ID"+ UUID.randomUUID().toString();
}

}
